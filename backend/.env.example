# Local Proofgrove classroom profile. No credentials are needed.
APP_ENV=dev
APP_PORT=8010
DATABASE_URL=sqlite+aiosqlite:///./data/eval-ai.db
DATABASE_AUTO_CREATE=true
EVALUATION_RUNTIME=local
PLATFORM_AUTH_REQUIRED=false
POD_NAMESPACE=tenant-local-classroom
JUDGE_MODE=mock
JUDGE_USE_FRAMEWORKS=false
TRACE_ARCHIVE_ENABLED=false
TRACE_INDEX_ENABLED=false
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
# Send x-evalai-tenant: local-classroom and x-evalai-sub: local-instructor.
# Mock semantic scores are synthetic pipeline demonstrations, not quality measurements.
# Seeded comparisons use real deterministic F1/ROUGE/BLEU scores.
# Document recall is not applicable without an attested retrieval stage.
